# Адрес Schautrack (без /api/v1). Из контейнера в сети Schautrack: http://web:3000
SCHAUTRACK_URL=http://web:3000
# Schautrack → Settings → Account → API tokens.
# Нужные scopes: entries:write, foods:write, weight:write
SCHAUTRACK_TOKEN=stk_...

# Токен, который picoclaw передаёт в заголовке Authorization: Bearer ...
# Сгенерировать: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me
