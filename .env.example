# Адрес Schautrack (без /api/v1). Из контейнера в сети Schautrack: http://web:3000
SCHAUTRACK_URL=http://web:3000

# По умолчанию каждый клиент передаёт свой токен Schautrack в заголовке
# Authorization: Bearer stk_...  — больше ничего настраивать не нужно.

# Однопользовательский режим (для совместимости): клиент передаёт MCP_AUTH_TOKEN,
# а в Schautrack всегда уходит SCHAUTRACK_TOKEN.
# MCP_AUTH_TOKEN=
# SCHAUTRACK_TOKEN=stk_...
